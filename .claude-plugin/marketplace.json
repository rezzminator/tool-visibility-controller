      "license": "MIT",
      "keywords": [
        "claude-code",
        "claude-code-plugin",
        "sub-agent",
        "subagent",
        "agent-scope",
        "agent-listing",
        "agent-permissions",
        "function-hooks",
        "claude-mods",
        "multi-agent",
        "orchestration",
        "professor"
      ],
      "author": {
        "name": "Reza · Professor",
        "url": "https://github.com/rezzminator/professor"
      }
    }
  ]
}
