{
  "name": "tool-visibility-controller",
  "version": "0.2.0",
  "private": true,
  "description": "Claude Code plugin for per-agent tool visibility — hide and refuse subagents, skills, MCP and built-in tools per loop",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate --strict . && claude plugin validate --strict plugins/tool-visibility-controller",
    "release:check": "scripts/release-check.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "claude-code-hooks",
    "function-hooks",
    "subagents",
    "claude-code-subagents",
    "mcp",
    "mcp-tools",
    "claude-skills",
    "tool-permissions",
    "access-control",
    "agent-orchestration",
    "multi-agent",
    "context-engineering",
    "token-optimization",
    "claude-code-mods",
    "tool-visibility-controller"
  ]
}
