{
  "name": "agent-scope",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code plugin for parent-scoped subagents — hide a helper from every other agent listing and refuse its dispatch",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run --dir tests",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.hooks.json",
    "validate:plugin": "claude plugin validate --strict . && claude plugin validate --strict plugins/agent-scope",
    "release:check": "scripts/release-check.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "subagents",
    "claude-code-subagents",
    "subagent",
    "sub-agent",
    "claude-code-hooks",
    "function-hooks",
    "agent-orchestration",
    "multi-agent",
    "access-control",
    "agent-scope",
    "agent-listing",
    "context-engineering",
    "claude-code-mods",
    "claude-mods"
  ]
}
